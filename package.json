{
  "name": "time-weather",
  "version": "1.0.0",
  "private": true,
  "description": "A fast, accessible clock and weather web app (current conditions, 24-hour and 7-day forecasts). Static files, no build step.",
  "keywords": [
    "weather",
    "clock",
    "open-meteo",
    "github-pages",
    "vanilla-js",
    "accessibility"
  ],
  "homepage": "https://xdxd-lab.github.io/time_weather/",
  "bugs": {
    "url": "https://github.com/xdxd-lab/time_weather/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xdxd-lab/time_weather.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=90 \"tests/**/*.test.js\"",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  }
}
